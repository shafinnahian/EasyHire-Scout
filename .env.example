# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/easyhire_scout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=easyhire

# Redis / Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Configuration
PROJECT_NAME=EasyHire Scout
API_V1_STR=/api/v1

# LLM Configuration (DeepSeek API) - REQUIRED
# Get your API key from: https://platform.deepseek.com/api_keys
# SECURITY: This key is loaded from .env and NEVER committed to git
LLM_API_KEY=sk-placeholder-get-your-key-from-deepseek-dashboard
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3

# Feature Flags
ENABLE_LLM_MATCHING=true